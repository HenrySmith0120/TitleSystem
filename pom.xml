<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.henry</groupId>
    <artifactId>titlesystem</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>TitleSystem</name>
    <description>开源称号系统（Title System）- Paper 1.21.8</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <!-- 全部为公开仓库（可审计）：
         - papermc:        Paper 官方仓库
         - placeholderapi: PlaceholderAPI 官方仓库
         - jitpack:        直接构建官方 github.com/MilkBowl/VaultAPI 公开源码（仅编译期，provided 不打包） -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API（服务端运行时提供，provided 不打包进 jar） -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Adventure（Paper 自带，provided。仅用于 & 颜色代码解析，4.19.0 与服务端 4.20.x 二进制兼容） -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.24.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>4.24.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- VaultAPI：仅编译期使用（provided，不打包，服务器需自行安装 Vault）。
             VaultAPI 官方未发布到 Maven Central，JitPack 会直接构建官方公开源码
             github.com/MilkBowl/VaultAPI（v1.7.1 tag），完全可审计。
             若坚持只使用 Maven Central：删除本依赖 + hook/EconomyHook.java，并删除
             ShopGui.java 中的经济调用即可（免费称号功能不受影响）。 -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI（provided，可选安装，用于 %titlesystem_*% 占位符与配置内 PAPI 解析） -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- 数据库：HikariCP 连接池。
             provided：不打进插件 jar，运行时由 Paper 的 libraries 机制加载（见 plugin.yml 与 README） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.3.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- SQLite JDBC 驱动。
             provided：不打进插件 jar，运行时由 Paper 的 libraries 机制加载 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- 数据库驱动：
             MariaDB Java Client 兼容 MySQL 5.5+/8.x 与 MariaDB。
             provided：不打进插件 jar，运行时由 Paper 的 libraries 机制加载。
             如需换回 MySQL 官方驱动，替换为 com.mysql:mysql-connector-j:8.4.0
             并把 DatabaseManager 中的驱动类/URL 改回 com.mysql.cj.jdbc.Driver。 -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.10</version>
            <scope>provided</scope>
        </dependency>



        <!-- PlayerPoints（可选）：如需点数购买功能，取消注释依赖与对应仓库，
             再参考 hook/EconomyHook.java 自行实现一个 PointHook（公开 API，无反射）
        <dependency>
            <groupId>org.black_ixx</groupId>
            <artifactId>playerpoints</artifactId>
            <version>3.2.7</version>
            <scope>provided</scope>
        </dependency>
        -->
    </dependencies>

    <build>
        <finalName>TitleSystem-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- 全部依赖均为 provided（Paper/服务端提供或由 libraries 机制加载），无需 shade -->
        </plugins>
    </build>
</project>
